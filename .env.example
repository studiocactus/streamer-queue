# Variáveis de ambiente — WatchQueue
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no repositório.

# ============================================================
# Supabase
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
VITE_SUPPORT_URL=https://www.twitch.tv/subs/seu_canal

# ============================================================
# Twitch OAuth (usados apenas em Edge Functions, não no frontend)
# ============================================================
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/twitch-auth/callback
TWITCH_WEBHOOK_SECRET=your_webhook_secret_random_string

# ============================================================
# App
# ============================================================
APP_URL=https://your-vercel-app.vercel.app

# ============================================================
# Supabase Service Role (somente para Edge Functions e scripts locais)
# NUNCA exponha no frontend
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
